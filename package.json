{
  "name": "roxiespantry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "generate:product-images": "node scripts/generateProductImages.mjs",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "lint": "eslint .",
    "typecheck:client": "tsc -b",
    "typecheck:server": "npm run typecheck --prefix server",
    "verify": "npm run lint && npm run typecheck:client && npm run typecheck:server",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "generate:product-images": "node scripts/generateProductImages.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tabler/icons": "^3.48.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
